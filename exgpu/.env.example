# Copy to ".env" (which is gitignored) and change every value before any non-local use.
# docker-compose.yml reads this file natively. The Spring app reads it too, via
# spring.config.import=optional:file:.env[.properties] in application.properties — so
# DB_URL / DB_USERNAME / DB_PASSWORD apply to `./mvnw spring-boot:run` as well.
# Keep the POSTGRES_* and DB_* passwords identical or Flyway will fail to connect.

# --- Postgres ---
POSTGRES_DB=exgpu
POSTGRES_USER=exgpu
POSTGRES_PASSWORD=change-me

# --- Spring datasource (must match the Postgres values above) ---
DB_URL=jdbc:postgresql://localhost:5432/exgpu
DB_USERNAME=exgpu
DB_PASSWORD=change-me

# --- Grafana admin ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# --- App bind address ---
# 127.0.0.1 (default) = localhost only, not reachable from the LAN (recommended).
# 0.0.0.0 = reachable from the network; needed for Docker-based Prometheus scraping.
SERVER_ADDRESS=127.0.0.1

# --- Access credential signing ---
# HMAC key for compute access tokens. Generate a real one before any non-local use, e.g.
#   openssl rand -base64 48
ACCESS_SIGNING_SECRET=change-me-generate-a-long-random-value

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
